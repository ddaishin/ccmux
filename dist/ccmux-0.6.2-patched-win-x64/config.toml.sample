# ccmux 設定ファイル
# (このファイルは初回起動時に自動生成された雛形です。すべてコメントのため
#  そのままでは何も変わりません。必要な設定のコメントを外して使ってください)
#
# [[openers]] = ファイル別・外部オープナー設定(複数書けます)。
# ファイルツリーで選択(Enter / クリック)したファイルがマッチすると外部アプリで
# 開きます。未登録・起動失敗時は従来どおり TUI プレビュー。
#
# ファイルツリーのキー:
#   o = この設定に関係なく OS の既定アプリで開く(ディレクトリも可。
#       ディレクトリの挙動は下の open_directory_with_os_default で変えられます)
#   r = このファイルを再読み込み([[openers]] と open_directory_with_os_default が反映)
#   e = このファイル(config.toml)自体をエディタで開く(下の [editor] 参照)
#
# マッチの書き方:
# - extensions はドットなし。ファイル名の末尾一致(ドット境界)なので
#   "tar.gz" のような複合拡張子も書けます。より長い一致が優先されます
# - filenames は拡張子を持たないファイル用の完全一致("Makefile" 等)。
#   extensions のどのマッチよりも優先されます
# - 大文字小文字は区別しません
# - 同じ長さの一致が複数あれば、先に書いた [[openers]] が優先されます
#
# 起動方式(mode):
# - mode 省略 = command を直接起動。{file} は絶対パスに置換(省略時は末尾に付加)
# - mode = "default" = OS の既定アプリに委ねる(command / args は不要・無視)。
#   ストアアプリ(MSIX)はインストールパスにバージョン番号が入り、アプリ更新の
#   たびに直接パス指定が壊れるため、パスを書かずにこちらを使ってください

# 例1: 種類ごとに OS の既定アプリへ委ねる(ストアアプリはこの方式が安全)
# 1 ブロックに複数の拡張子を、ファイルには複数のブロックを書けます
#[[openers]]
#extensions = ["md", "markdown", "txt"]
#mode = "default"
#
#[[openers]]
#extensions = ["png", "jpg", "jpeg", "gif", "webp", "svg"]
#mode = "default"
#
#[[openers]]
#extensions = ["pdf", "xlsx", "docx", "pptx"]
#mode = "default"

# 例2: 種類ごとに別のアプリを指定する
# (Windows の .cmd シム(VS Code 等)は "code.cmd" のように拡張子まで書く)
#[[openers]]
#extensions = ["rs", "toml", "json", "yaml", "yml"]
#command = "code.cmd"
#args = ["{file}"]
#
# args を省略すると絶対パスが末尾に付きます(= args = ["{file}"] と同じ)
#[[openers]]
#extensions = ["log", "csv"]
#command = "notepad.exe"

# 例3: 複合拡張子。"gz" と "tar.gz" が両方あれば長い "tar.gz" が優先されます
#[[openers]]
#extensions = ["tar.gz", "tgz", "zip"]
#mode = "default"

# 例4: 拡張子のないファイル(filenames は extensions より優先)
#[[openers]]
#filenames = ["Makefile", "Dockerfile"]
#mode = "default"

# scrollback_lines = ペインごとのスクロールバック行数。既定 2000。
# 0 で履歴なし。上限 100000(超過分は切り詰め)。r キーでは反映されず再起動が必要。
# メモリ目安: 行数 × 画面桁数 × 32byte がペインごとの上限
#scrollback_lines = 2000

# open_directory_with_os_default = ファイルツリーで o を押したとき、
# ディレクトリを OS の既定ランチャ(Windows: explorer.exe / macOS: open /
# Linux: xdg-open)へ渡すか。既定 true(従来どおり)。
# false にすると外部起動を一切試みず、Enter と同じ展開/折りたたみになります。
# xdg-open が入っていない環境や headless 環境で、o の誤爆を防ぎたいときに。
# r キーで再起動なしに反映されます。
#open_directory_with_os_default = true

# [editor] = ファイルツリーで e を押したとき、このファイル(config.toml)を
# 開くエディタの設定です。command を省略すると $VISUAL -> $EDITOR -> OS の
# 既定アプリの順にフォールバックします。
#[editor]
# command = vim / nano のようなターミナルエディタは in_pane = true(既定)の
# ままで構いません。VS Code や メモ帳のような GUI エディタを使う場合は、
# 下の in_pane を false にしてください(true のままだと、ペイン内で GUI
# エディタのプロセスがすぐ制御を返してしまい、何も起きたように見えません)。
#command = "vim"
# args を省略すると絶対パスが末尾に付きます(= args = ["{file}"] と同じ)。
#args = ["{file}"]
# true(既定) = ccmux のペイン内で起動(ターミナルエディタ向け)。
# false = 別ウィンドウで起動(GUI エディタ向け)。
#in_pane = true
# in_pane = true で開いたエディタを閉じると、config.toml は自動で
# 再読み込みされます。in_pane = false(GUI エディタ)の場合は、閉じても
# 自動では反映されないため r キーで手動リロードしてください。
